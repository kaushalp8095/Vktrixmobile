<?xml version="1.0" encoding="utf-8"?>
<!-- Sirf HTTPS. App ka server (https://), update APK (GitHub https) aur koi bhi
     plugin request plain HTTP par nahi ja sakti, isliye public Wi-Fi par baitha
     attacker token/bill intercept ya badal nahi sakta. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
