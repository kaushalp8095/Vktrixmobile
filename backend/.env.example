PORT=4000
# production me NODE_ENV=production rakhein — warna JWT_SECRET/SUPERADMIN_PASSWORD
# ke production guards chalu nahi hote.
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_secret
# Production: PostgreSQL
DB_CLIENT=pg
DATABASE_URL=postgres://user:password@localhost:5432/mobileshop
# Local testing (no Postgres needed):
# DB_CLIENT=better-sqlite3
# SQLITE_FILE=./dev.sqlite
SUPERADMIN_USERNAME=superadmin
# Required in production; without it the server refuses to create the first admin.
SUPERADMIN_PASSWORD=change_this_to_a_strong_password
# Proxy ke peeche (Render/Cloudflare) asli client IP ke liye trusted hops.
# Render: 1. Bina proxy: 0 (default). Zyada hops maan-ne par X-Forwarded-For
# spoof ho sakta hai, isliye apne setup ke hisaab se hi set karein.
TRUST_PROXY_HOPS=0
# Browser client (Flutter web/panel) ho to exact origins, comma separated.
# Mobile app ko CORS ki zaroorat nahi — khaali chhodein.
# CORS_ORIGINS=https://admin.example.com
# API-wide rate limit (per IP) aur auth limits.
# RATE_LIMIT_MAX=1000
# AUTH_LOGIN_MAX=10
# AUTH_IP_MAX=100
# Managed Postgres ka CA (PEM) — TLS certificate verify karne ke liye.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Free TAC catalogs (optional overrides). Two free catalogs can be synced from
# Super Admin -> TAC catalog: "Osmocom" (community) and "Extended" (India models).
# TAC_SYNC_URL=http://tacdb.osmocom.org/export/tacdb.csv
# TAC_SYNC_TIMEOUT_MS=120000
# TAC_SYNC_MAX_MB=25
# TAC_SYNC_MIN_ROWS=100
# Extended catalog (MoazEb/tac-database, MIT). Comma/space separated URLs = mirrors,
# the next one is tried when the previous fails.
# TAC_SYNC_TACDB_URL=https://raw.githubusercontent.com/MoazEb/tac-database/main/tac_full.csv
# TAC_SYNC_TACDB_TIMEOUT_MS=300000
# TAC_SYNC_TACDB_MAX_MB=30
# TAC_SYNC_TACDB_MIN_ROWS=150000
# Optional: ask a TAC API when the local catalog misses (brand + model only).
# Off unless TAC_API_URL is set. Each TAC is looked up at most once, ever.
# Example for HiCellTek (100 free lookups/month): https://hicelltek.com/en/api/imei/
# TAC_API_URL=https://imei.hicelltek.com/api/v1/tac/lookup
# TAC_API_KEY=
# TAC_API_METHOD=POST
# TAC_API_TIMEOUT_MS=4000
